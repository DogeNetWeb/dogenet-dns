+        if (tok < 1.0) { DnsLazyStats ls_; dns_lazy_stats(&ls_); if (ls_.queued > 0) g.c.lz_rate_wait++; break; }   /* flood: stays LOADING */
+        LzFetch *fr = NULL;
+        for (int i = 0; i < LZ_SLOTS && !fr; i++) if (!g_lz[i].name[0]) fr = &g_lz[i];
+        if (!fr) break;
