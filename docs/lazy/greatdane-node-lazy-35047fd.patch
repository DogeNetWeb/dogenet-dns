+        if (!sp_name_valid(nm, strlen(nm)) || lz_find(nm)) continue;
+        memset(fr, 0, sizeof *fr);
+        snprintf(fr->name, sizeof fr->name, "%s", nm);
+        fr->start_ms = now;
+        dns_lazy_begin(nm); g.c.lz_fetch++; tok -= 1.0;
+        for (int k = 0; k < LZ_FANOUT; k++) if (!lz_ask(fr, now)) break;
+    }
