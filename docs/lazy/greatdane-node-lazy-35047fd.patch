+}
+static void lz_backoff(Peer *p, int64_t base_ms, unsigned n, int64_t cap_ms, int64_t now) {
+    int64_t b = base_ms;
+    for (unsigned i = 1; i < n && b < cap_ms; i++) b *= 2;
+    if (b > cap_ms) b = cap_ms;
+    if (now + b > p->lz_backoff_ms) p->lz_backoff_ms = now + b;
+}
+/* the held op-set sum of a name (clear + rows), to judge each answer */
+static int lz_held_cb(void *u, const uint8_t *key, int klen, int op, uint32_t anchor, const uint8_t *blob, int blen) {
+    (void)key; (void)klen; (void)op; (void)anchor;
+    SpStateOp p;
+    if (sp_state_op_parse(blob, blen, &p)) lz_sum_add(u, p.op_id);
+    return 1;
+}
+static void lz_held_sum(const char *name, LzSum *s) {
+    memset(s, 0, sizeof *s);
+    uint8_t *cb; int cl;
+    if (sp_state_clear_get(g.st, name, &cb, &cl)) {
+        SpStateOp p;
+        if (sp_state_op_parse(cb, cl, &p)) lz_sum_add(s, p.op_id);
+        free(cb);
+    }
+    sp_state_iter(g.st, name, lz_held_cb, s);
+}
+static void lz_finish(LzFetch *f, int ok, int64_t now) {
+    if (ok) {
+        LzSum held; lz_held_sum(f->name, &held);
+        for (int i = 0; i < f->nask; i++) {
+            Peer *p = f->ask[i].p;
+            if (f->ask[i].st != LZA_OK || !p->used || p->gen != f->ask[i].gen) continue;
+            if (memcmp(&f->ask[i].sum, &held, sizeof held)) {       /* behind / withheld */
+                p->lz_stale++; g.c.lz_stale++;
+                lz_backoff(p, 10000, 1, 10000, now);
+            } else { p->lz_ok++; if (p->lz_fail) p->lz_fail--; }
+        }
+        int64_t bytes = sp_state_sum(g.st, f->name);
+        dns_lazy_done(f->name, 1, bytes, held.n == 0);
+        g.c.lz_ok++;
+    } else {
+        dns_lazy_done(f->name, 0, 0, 0);
+        g.c.lz_fail++;
+    }
+    for (int i = 0; i < f->nask; i++)                       /* free the per-peer seats */
+        if (f->ask[i].st == LZA_SENT && f->ask[i].p->gen == f->ask[i].gen && f->ask[i].p->lz_inflight > 0)
+            f->ask[i].p->lz_inflight--;
+    f->name[0] = '\0';
+    lz_evict();
+}
+/* A2: zone digest = sha256(sorted op_ids of the held zone, clear op incl.) */
+typedef struct { uint8_t (*id)[32]; int n, cap; } LzIds;
+static int lz_ids_cb(void *u, const uint8_t *key, int klen, int op, uint32_t anchor, const uint8_t *blob, int blen) {
+    (void)key; (void)klen; (void)op; (void)anchor;
+    LzIds *v = u; SpStateOp p;
+    if (!sp_state_op_parse(blob, blen, &p)) return 1;
+    if (v->n == v->cap) {
+        int nc = v->cap ? v->cap * 2 : 32;
+        void *t = realloc(v->id, (size_t)nc * 32); if (!t) return 0;
+        v->id = t; v->cap = nc;
+    }
+    memcpy(v->id[v->n++], p.op_id, 32);
+    return 1;
+}
+static int lz_id_cmp(const void *a, const void *b) { return memcmp(a, b, 32); }
+int dnsnet_zone_digest(const char *name, uint8_t out[32]) {
+    LzIds v = { 0 };
+    uint8_t *cb; int cl;
+    if (g.st && sp_state_clear_get(g.st, name, &cb, &cl)) { lz_ids_cb(&v, NULL, 0, 0, 0, cb, cl); free(cb); }
+    if (g.st) sp_state_iter(g.st, name, lz_ids_cb, &v);
+    if (v.n > 1) qsort(v.id, (size_t)v.n, 32, lz_id_cmp);
+    sp_sha256(v.n ? (const uint8_t *)v.id : (const uint8_t *)"", (size_t)v.n * 32, out);
+    free(v.id);
+    return v.n;
+}
+/* 1 = no commitment known, or the held zone matches it */
+static int lz_digest_final(LzFetch *f) {
+    uint8_t want[32], have[32];
+    if (!dns_lazy_committed_digest(f->name, want)) return 1;
+    dnsnet_zone_digest(f->name, have);
+    if (!memcmp(want, have, 32)) return 1;
+    g.c.lz_digest_bad++;
+    return 0;
+}
+/* quorum reached: with a commitment, a mismatch means every answer so far was
+ * stale/withheld — penalize them and keep asking others (bounded) */
+static int lz_digest_gate(LzFetch *f, int64_t now) {
+    if (lz_digest_final(f)) return 1;
+    for (int i = 0; i < f->nask; i++) if (f->ask[i].st == LZA_OK) {
+        Peer *p = f->ask[i].p;
+        f->ask[i].st = LZA_BAD;
+        if (p->used && p->gen == f->ask[i].gen) { p->lz_stale++; g.c.lz_stale++; lz_backoff(p, 10000, 1, 10000, now); }
+    }
+    f->ok_n = 0; f->first_ok_ms = 0;
+    if (++f->digest_retry > LZ_DIGEST_RETRY || !lz_ask(f, now)) { lz_finish(f, 0, now); return 0; }
+    return 0;
+}
+
+/* end the fetch when it has what it needs (also called on each answer) */
+static void lz_check(LzFetch *f, int64_t now) {
+    int out = lz_outstanding(f);
+    /* keep LZ_FANOUT asks open until we have a quorum of valid answers */
+    while (f->ok_n + out < LZ_QUORUM && lz_ask(f, now)) out++;
+    int more = lz_can_ask_more(f, now);
+    if (f->ok_n >= LZ_QUORUM ||
+        (f->ok_n >= 1 && out == 0 && !more) ||
+        (f->ok_n >= 1 && now - f->first_ok_ms >= LZ_SETTLE_MS && out == 0) ||
+        (f->ok_n >= 1 && now - f->first_ok_ms >= LZ_SETTLE_MS + LZ_ASK_TIMEOUT_MS)) {
+        if (lz_digest_gate(f, now)) lz_finish(f, 1, now);
+    } else if (now - f->start_ms >= LZ_FETCH_MAX_MS) {
+        int ok = f->ok_n > 0 || f->empty_n >= LZ_EMPTY_MIN;
+        if (ok && !lz_digest_final(f)) ok = 0;
+        lz_finish(f, ok, now);
+    } else if (f->ok_n == 0 && out == 0 && f->nask > 0 && !more) {
+        /* everyone tried: all said "nothing" = verified-empty (if a digest is
+         * committed it must match the empty set); else nothing valid = FAILED */
+        lz_finish(f, f->empty_n >= LZ_EMPTY_MIN && lz_digest_final(f), now);
+    }
+}
+/* an answer for a name we track arrived; 1 = it answers one of our fetch asks */
+static int lz_on_dat(Peer *from, const char *name, int ops, int rejected, int pending, const LzSum *sum) {
+    LzFetch *f = lz_find(name);
+    if (!f) return 0;
+    int64_t now = now_ms();
+    for (int i = 0; i < f->nask; i++) {
+        if (f->ask[i].p != from || f->ask[i].gen != from->gen || f->ask[i].st != LZA_SENT) continue;
+        if (from->lz_inflight > 0) from->lz_inflight--;
+        if (rejected > 0) {                                  /* forged / unverifiable ops */
+            from->lz_bad++; g.c.lz_forged++;
+            lz_backoff(from, 30000, from->lz_bad, 600000, now);
+        }
+        (void)ops; (void)pending;
+        if (rejected > 0) {
+            /* a peer that served ANY op failing verification is not trusted to
+             * have served the WHOLE zone: its valid (owner-signed) ops still
+             * landed, but its answer never completes a fetch — ask another. If
+             * nobody else answers, the fetch FAILS (EDE 22), so a partial zone
+             * from a forger is never served as if it were complete. */
+            f->ask[i].st = LZA_BAD;
+            lz_ask(f, now);
+        } else if (pending == 2) {
+            /* incomplete answer (the host's per-peer verify budget cut the
+             * dump short; PepeNet ECDSA throttle): not a vote either way, no
+             * penalty -- ask another peer; the leftover arrives on retry */
+            f->ask[i].st = LZA_TIMEOUT;
+            lz_ask(f, now);
+        } else if (sum->n == 0 && ops == 0) {
+            /* holds nothing: NOT a vote that the zone is empty (a lazy peer
+             * that never fetched it answers this too). No penalty; ask the
+             * next. Verified-empty only when every candidate said so. */
+            f->ask[i].st = LZA_EMPTY; f->empty_n++; from->lz_empty++; g.c.lz_empty++;
+            lz_ask(f, now);
+        } else {
+            f->ask[i].st = LZA_OK; f->ask[i].sum = *sum;
+            f->ok_n++; if (from->lz_empty) from->lz_empty--;
+            if (!f->first_ok_ms) f->first_ok_ms = now;
+        }
+        lz_check(f, now);                                    /* quorum: done now, not next tick */
+        return 1;
+    }
+    return 0;
+}
+static void lz_peer_down(Peer *p) {
+    for (int s = 0; s < LZ_SLOTS; s++) {
+        LzFetch *f = &g_lz[s];
+        if (!f->name[0]) continue;
+        for (int i = 0; i < f->nask; i++)
+            if (f->ask[i].p == p && f->ask[i].gen == p->gen && f->ask[i].st == LZA_SENT)
+                f->ask[i].st = LZA_TIMEOUT;                  /* lz_service asks another */
+    }
+    p->lz_inflight = 0;
+}
+static void lz_service(int64_t now) {
+    /* start queued fetches */
+    char nm[64];
+    static double tok = LZ_START_BURST; static int64_t tok_ms;
+    if (tok_ms) { tok += (double)(now - tok_ms) * LZ_START_RATE / 1000.0; if (tok > LZ_START_BURST) tok = LZ_START_BURST; }
+    tok_ms = now;
