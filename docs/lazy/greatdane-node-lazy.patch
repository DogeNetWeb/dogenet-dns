-int resolver_lookup(const char *sni, OriginInfo *out, void *ud) {
+/* lazy gate: owned apex whose zone is not READY -> LOADING / FETCH_FAILED.
+ * recheck=1 does not count a new miss (a waiting request polling). */
+static int lazy_gate(Resolver *r, const char *sni, int recheck) {
+    if (!dns_lazy_enabled()) return RES_OK;
+    char apex[64], sub[128];
+    if (!origin_split(sni, r->suffix, apex, sizeof apex, sub, sizeof sub)) return RES_OK;
+    for (char *c = apex; *c; c++) if (*c >= 'A' && *c <= 'Z') *c += 'a' - 'A';
+    pthread_mutex_lock(&r->mu);
+    uint8_t owner[20], held[20];
+    int owned = r->orc.owner_now(r->orc.u, apex, owner);
+    int stale_owner = owned && sp_state_owner(r->st, apex, held) && memcmp(held, owner, 20) != 0;
+    pthread_mutex_unlock(&r->mu);
+    if (!owned) return RES_OK;                      /* resolver_lookup says UNOWNED */
+    if (stale_owner) dns_lazy_invalidate(apex);     /* rows of a previous owner: refetch */
+    int s = recheck ? dns_lazy_want_recheck(apex, NULL) : dns_lazy_want(apex, NULL);
+    if (s == DNS_LAZY_READY) return RES_OK;
+    return s == DNS_LAZY_FAILED ? RES_FETCH_FAILED : RES_LOADING;
+}
+
+static int lookup_impl(const char *sni, OriginInfo *out, void *ud, int recheck) {
     Resolver *r = ud;
     if (!r || !sni || !out) return RES_BAD_NAME;
+    int lz = lazy_gate(r, sni, recheck);
+    if (lz != RES_OK) return lz;
     if (resolver_resolve(sni, out, ud)) return RES_OK;
     char apex[64], sub[128];
     if (!origin_split(sni, r->suffix, apex, sizeof apex, sub, sizeof sub))
@@ -134,3 +157,21 @@
     pthread_mutex_unlock(&r->mu);
     return has ? RES_BAD_RECORD : RES_NO_TLSA;
 }
+
+int resolver_lookup(const char *sni, OriginInfo *out, void *ud) {
+    return lookup_impl(sni, out, ud, 0);
+}
+
+int resolver_lookup_wait(const char *sni, OriginInfo *out, void *ud, int wait_ms) {
+    int rc = lookup_impl(sni, out, ud, 0);
+    struct timespec t0, t, d = { 0, 25 * 1000000L };
+    clock_gettime(CLOCK_MONOTONIC, &t0);
+    while (rc == RES_LOADING && wait_ms > 0) {
+        clock_gettime(CLOCK_MONOTONIC, &t);
+        if ((t.tv_sec - t0.tv_sec) * 1000 + (t.tv_nsec - t0.tv_nsec) / 1000000 >= wait_ms) break;
+        nanosleep(&d, NULL);
+        dns_lazy_poke();                 /* net tick checks fetch timeouts: keep it brisk */
+        rc = lookup_impl(sni, out, ud, 1);
+    }
+    return rc;
+}
