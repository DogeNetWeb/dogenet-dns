 // ---- GreatDANE M3 (opt-in, --dane-api): the browser verifies DANE itself. ---
 // The node never terminates TLS in this mode: CONNECT splices raw TCP to the
 // chain A record, and GET /gd/tlsa?host= hands the browser the on-chain TLSA.
+/* lazy node: how long /gd/tlsa and a passthrough CONNECT wait for a cold
+ * zone before answering "loading" (GREATDANE_NODE_LAZY_WAIT_MS, 0..9000,
+ * default 3000 -- well inside Dane's 10 s budget). */
+static int gd_lazy_wait_ms(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char *e = getenv("GREATDANE_NODE_LAZY_WAIT_MS");
+        int x = e && *e ? atoi(e) : 3000;
+        v = x < 0 ? 0 : x > 9000 ? 9000 : x;
+    }
+    return v;
+}
